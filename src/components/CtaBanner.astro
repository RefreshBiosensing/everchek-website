---
// Dark banner + 3-field enquiry form, shown at the foot of every page.
// The full form lives on /contact/. Copy comes from the locale dictionary.
import { loadDict } from '../lib/content';
import MiniForm from './MiniForm.astro';

interface Props {
  locale?: string;
  /** 'form' (default) shows the 3-field mini enquiry form.
      'link' is the original site's footer CTA — heading, line, button — and is
      what a page that already carries a real form should use, so a visitor is
      never asked to fill in two different forms on one page. */
  variant?: 'form' | 'link';
  title?: string;
  sub?: string;
  fullFormLink?: string;
  /** Link variant only — defaults to the dictionary's contact CTA. */
  buttonLabel?: string;
  fullFormHref?: string;
  messagePlaceholder?: string;
}
const {
  locale = 'en',
  variant: variantProp,
  title,
  sub,
  fullFormLink,
  buttonLabel,
  fullFormHref,
  messagePlaceholder,
} = Astro.props;

const variant = variantProp ?? 'form';
const common = loadDict(locale);
const { ctaBanner, footer, cta } = common;
const copy = {
  ...ctaBanner,
  ...(title ? { title } : {}),
  ...(sub ? { sub } : {}),
  ...(fullFormLink ? { fullFormLink } : {}),
  ...(buttonLabel ? { buttonLabel } : {}),
  ...(fullFormHref ? { fullFormHref } : {}),
  ...(messagePlaceholder ? { messagePlaceholder } : {}),
};
---
<section class:list={['cta-banner', { 'cta-link-only': variant === 'link' }]}>
  <div class="container cta-inner">
    <div class="cta-copy">
      <h2 class="cta-title">{copy.title}</h2>
      <p class="cta-sub">{copy.sub}</p>
      {variant === 'link' ? (
        <a class="btn primary cta-btn" href={copy.fullFormHref ?? '/contact/'}>{copy.buttonLabel ?? cta?.quote ?? 'Contact us'}</a>
      ) : (
        <a class="cta-full-link" href={copy.fullFormHref ?? '/contact/'}>{copy.fullFormLink} →</a>
      )}
    </div>
    {variant === 'form' && <MiniForm t={copy} email={footer?.email} locale={locale} />}
  </div>
</section>

<style>
  .cta-banner {
    background: linear-gradient(135deg, var(--navy) 0%, #1d3a4d 100%);
    padding: clamp(56px, 7vw, 88px) 0;
  }
  /* Link variant: one centred column, as the original footer CTA was. */
  .cta-banner.cta-link-only .cta-inner { display: block; text-align: center; }
  .cta-banner.cta-link-only .cta-copy { max-width: 680px; margin: 0 auto; }
  .cta-banner.cta-link-only .cta-sub { margin-left: auto; margin-right: auto; }
  .cta-btn { margin-top: 24px; }
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .cta-title {
    color: #fff;
    font-size: clamp(23px, 2.6vw, 30px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    max-width: 460px;
  }
  .cta-sub { color: #8aabb8; margin-top: 12px; max-width: 460px; font-size: 15.5px; line-height: 1.65; }
  .cta-full-link {
    display: inline-block;
    margin-top: 18px;
    color: var(--blue);
    font-size: 14px;
    font-weight: 600;
  }
  .cta-full-link:hover { text-decoration: underline; }

  @media (max-width: 860px) {
    .cta-inner { grid-template-columns: 1fr; }
    .cta-title, .cta-sub { max-width: none; }
  }
</style>
