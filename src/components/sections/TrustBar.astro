---
// 深色信任条 — slim strip of proof points under the hero.
import Icon from '../Icon.astro';

interface Props {
  label?: string;
  items: string[];
  dark?: boolean;
}
const { label, items = [], dark = false } = Astro.props;
---
<section class:list={['trustbar', { dark }]}>
  <div class="container tb-inner">
    {label && <span class="tb-label">{label}</span>}
    <div class="tb-items">
      {items.map((item) => (
        <span class="tb-item"><Icon name="check" size={14} /> {item}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .trustbar { border-bottom: 1px solid var(--border); background: #fff; }
  .trustbar.dark { background: var(--navy); border-bottom-color: rgba(128, 188, 226, 0.2); }
  .tb-inner { display: flex; align-items: center; gap: 28px; padding-top: 20px; padding-bottom: 20px; flex-wrap: wrap; }
  .tb-label { font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--soft); flex-shrink: 0; }
  .dark .tb-label { color: #7a9baa; }
  .tb-items { display: flex; gap: 26px; flex-wrap: wrap; }
  .tb-item { display: inline-flex; align-items: center; gap: 7px; font-size: 13.5px; font-weight: 600; color: var(--mid); }
  .dark .tb-item { color: #b8cdd9; }
  .tb-item :global(svg) { color: var(--blue-dark); }
  .dark .tb-item :global(svg) { color: var(--blue); }
</style>
