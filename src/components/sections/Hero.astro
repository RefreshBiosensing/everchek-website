---
// Page hero — always the first section, owns the page's single <h1>.
//
// variant:
//   standard  gradient bg, left-aligned copy               (default)
//   centered  gradient bg, centered copy
//   dark      navy banner, light copy
//   split     copy left + visual right (see `visual`)
//   form      copy left + enquiry mini-form right
//
// visual (split only):
//   device-collage   home-style floating device/phone/terminal art
//   product-tiles    product-page 4-tile grid (device/app/patches/terminal)
//   product-gallery  main product visual + 7 thumbnails
//   ward-dashboard   monitoring-system live ward mock
//   image            a real image (src in `image`)
import Icon from '../Icon.astro';
import MiniForm from '../MiniForm.astro';
import BlockImage from '../blocks/BlockImage.astro';
import VisualDevice from '../VisualDevice.astro';
import VisualPhone from '../VisualPhone.astro';
import VisualTerminal from '../VisualTerminal.astro';
import VisualProductGallery from '../VisualProductGallery.astro';
import { loadDict } from '../../lib/content';

interface Btn { label: string; href: string; style?: 'primary' | 'ghost' }
interface GalleryItem {
  label: string;
  image?: string;
  alt?: string;
  view?: 'angle-front' | 'side-top' | 'back' | 'side-left' | 'front' | 'side-right' | 'angle-back' | 'side-bottom';
}
interface Props {
  locale?: string;
  variant?: 'standard' | 'centered' | 'dark' | 'split' | 'form';
  eyebrow?: string;   // hidden site-wide, kept for archive
  kicker?: string;    // visible pill above the title
  title: string;
  sub?: string;
  buttons?: Btn[];
  stats?: { value: string; label: string }[];
  badges?: string[];
  kit?: { label: string; items: string[] };
  note?: string;
  visual?: 'device-collage' | 'product-tiles' | 'product-gallery' | 'ward-dashboard' | 'phone-panel' | 'terminal-panel' | 'image';
  visualLabels?: { device?: string; app?: string; patch1?: string; patch2?: string; terminal?: string };
  gallery?: GalleryItem[];
  image?: string;
  imageAlt?: string;
  imageNote?: string;
  ratio?: string;
  backgroundImage?: string;
}
const {
  locale = 'en',
  variant = 'standard',
  eyebrow, kicker, title, sub,
  buttons = [], stats = [], badges = [],
  kit, note,
  visual, visualLabels = {}, gallery,
  image, imageAlt, imageNote, ratio = '4/3', backgroundImage,
} = Astro.props;

const dict = loadDict(locale);
const hasVisualCol = variant === 'split' || variant === 'form';
const kitIcons = ['sensor', 'patch', 'battery', 'box'];

// Ward mock defaults — decorative, aria-hidden.
const wardCells: [string, string, string][] = [
  ['Bed 01', '36.7', 'ok'], ['Bed 02', '37.1', 'ok'], ['Bed 03', '38.6', 'alert'],
  ['Bed 04', '36.9', 'ok'], ['Bed 05', '37.4', 'warn'], ['Bed 06', '36.8', 'ok'],
  ['Bed 07', '36.6', 'ok'], ['Bed 08', '37.0', 'ok'], ['Bed 09', '36.8', 'ok'],
];
---
<section
  class:list={['hero-sec', `hv-${variant}`, { 'hero-bg': Boolean(backgroundImage) }]}
  style={backgroundImage ? `--hero-bg-image: url("${backgroundImage}")` : undefined}
>
  <div class:list={['container', { 'hero-grid': hasVisualCol }]}>
    <div class:list={['hero-copy', { center: variant === 'centered' }]}>
      {eyebrow && <div class="eyebrow">{eyebrow}</div>}
      {kicker && <div class="hero-kicker">{kicker}</div>}
      <h1 class="hero-title">{title}</h1>
      {sub && <p class="hero-sub">{sub}</p>}

      {badges.length > 0 && (
        <div class="hero-badges">
          {badges.map((b) => <span class="pill"><span class="dot"></span>{b}</span>)}
        </div>
      )}

      {kit && (
        <div class="hero-kit">
          <div class="kit-label">{kit.label}</div>
          <div class="kit-items">
            {kit.items.map((item, i) => (
              <span class="kit-item"><Icon name={kitIcons[i % kitIcons.length]} size={16} />{item}</span>
            ))}
          </div>
        </div>
      )}

      {buttons.length > 0 && (
        <div class="hero-btns">
          {buttons.map((b) => (
            <a class:list={['btn', b.style === 'ghost' ? (variant === 'dark' ? 'on-dark' : 'ghost') : 'primary']} href={b.href}>{b.label}</a>
          ))}
        </div>
      )}

      {note && <p class="hero-note">{note}</p>}

      {stats.length > 0 && (
        <div class="hero-stats">
          {stats.map((s) => (
            <div class="hs">
              <div class="hs-val">{s.value}</div>
              <div class="hs-label">{s.label}</div>
            </div>
          ))}
        </div>
      )}
    </div>

    {variant === 'form' && (
      <div class="hero-form-panel">
        <MiniForm t={dict.ctaBanner} email={dict.footer?.email} />
      </div>
    )}

    {variant === 'split' && visual === 'device-collage' && (
      <div class="hv-collage" aria-hidden="true">
        <div class="hvc-glow"></div>
        <div class="hvc-device"><VisualDevice size={210} /></div>
        <div class="hvc-phone"><VisualPhone width={165} /></div>
        <div class="hvc-terminal"><VisualTerminal width={130} /></div>
      </div>
    )}

    {variant === 'split' && visual === 'product-tiles' && (
      <div class="hv-tiles">
        <div class="pv-tile pv-main">
          <VisualDevice size={185} />
          {visualLabels.device && <span class="pv-label">{visualLabels.device}</span>}
        </div>
        <div class="pv-tile pv-app">
          <VisualPhone width={140} />
          {visualLabels.app && <span class="pv-label on-dark">{visualLabels.app}</span>}
        </div>
        <div class="pv-tile pv-patch">
          <div class="patch-item">
            <div class="patch-circle"><Icon name="patch" size={30} /></div>
            <span>{visualLabels.patch1}</span>
          </div>
          <div class="patch-item">
            <div class="patch-circle alt"><Icon name="battery" size={30} /></div>
            <span>{visualLabels.patch2}</span>
          </div>
        </div>
        <div class="pv-tile pv-terminal">
          <VisualTerminal width={125} />
          {visualLabels.terminal && <span class="pv-label">{visualLabels.terminal}</span>}
        </div>
      </div>
    )}

    {variant === 'split' && visual === 'product-gallery' && (
      <VisualProductGallery items={gallery} />
    )}

    {variant === 'split' && visual === 'ward-dashboard' && (
      <div class="ward-visual" aria-hidden="true">
        <div class="ward-head">
          <span>WARD 3 · LIVE</span>
          <span class="ward-ok">14 monitored</span>
        </div>
        <div class="ward-grid">
          {wardCells.map(([bed, temp, tone]) => (
            <div class:list={['ward-cell', tone]}>
              <span class="wc-bed">{bed}</span>
              <span class="wc-temp">{temp}°</span>
            </div>
          ))}
        </div>
        <div class="ward-alertbar">⚠ Bed 03 — 38.6°C · threshold crossed 2 min ago</div>
      </div>
    )}

    {variant === 'split' && visual === 'phone-panel' && (
      <div class="hv-panel dark-panel">
        <VisualPhone width={190} />
      </div>
    )}

    {variant === 'split' && visual === 'terminal-panel' && (
      <div class="hv-panel light-panel">
        <VisualTerminal width={210} />
      </div>
    )}

    {variant === 'split' && visual === 'image' && (
      <div class="hv-image">
        <BlockImage src={image} alt={imageAlt ?? title} ratio={ratio} note={imageNote} />
      </div>
    )}
  </div>
</section>

<style>
  .hero-sec {
    background:
      radial-gradient(900px 480px at 85% 10%, rgba(128, 188, 226, 0.18), transparent 65%),
      linear-gradient(180deg, var(--blue-faint), #fff 78%);
    overflow: hidden;
    padding: clamp(52px, 6.5vw, 92px) 0;
  }
  .hero-sec.hero-bg {
    min-height: 560px;
    display: flex;
    align-items: center;
    background-image:
      linear-gradient(90deg, rgba(9, 29, 43, 0.7), rgba(9, 29, 43, 0.42)),
      var(--hero-bg-image);
    background-size: cover;
    background-position: center;
  }
  .hero-bg .hero-copy { max-width: 900px; margin-inline: auto; }
  .hero-bg .hero-title { max-width: 900px; color: #fff; }
  .hero-bg .hero-sub { max-width: 760px; margin-inline: auto; color: rgba(255, 255, 255, 0.88); }
  .hero-bg .eyebrow { color: #d8f0ff; }
  .hv-dark {
    background: linear-gradient(135deg, var(--navy) 0%, #1d3a4d 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
  }
  .hero-copy.center { text-align: center; margin-inline: auto; max-width: 780px; }
  .hero-copy.center .hero-sub { margin-inline: auto; }
  .hero-copy.center .hero-btns,
  .hero-copy.center .hero-badges,
  .hero-copy.center .hero-stats { justify-content: center; }

  .hero-kicker {
    display: inline-block;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--blue-deep);
    background: rgba(128, 188, 226, 0.16);
    border: 1px solid rgba(128, 188, 226, 0.35);
    border-radius: 999px;
    padding: 7px 16px;
    margin-bottom: 22px;
  }
  .hv-dark .hero-kicker { color: var(--blue); border-color: rgba(128, 188, 226, 0.4); }

  .hero-title {
    font-size: clamp(30px, 3.8vw, 48px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.028em;
    max-width: 640px;
  }
  .hero-copy.center .hero-title { margin-inline: auto; }
  .hv-dark .hero-title { color: #fff; }

  .hero-sub { font-size: 17.5px; color: var(--mid); line-height: 1.7; margin-top: 18px; max-width: 560px; }
  .hv-dark .hero-sub { color: #8aabb8; }

  .hero-badges { display: flex; gap: 9px; flex-wrap: wrap; margin-top: 22px; }

  .hero-kit { margin-top: 22px; }
  .kit-label { font-size: 11px; font-weight: 700; letter-spacing: 0; text-transform: none; color: var(--soft); margin-bottom: 9px; }
  .kit-items { display: flex; gap: 14px 22px; flex-wrap: wrap; }
  .kit-item { display: inline-flex; align-items: center; gap: 7px; font-size: 13.5px; font-weight: 600; color: var(--mid); }
  .kit-item :global(svg) { color: var(--blue-deep); }

  .hero-btns { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .hero-note { font-size: 12.5px; color: var(--soft); margin-top: 14px; max-width: 520px; line-height: 1.6; }
  .hv-dark .hero-note { color: #6b8898; }

  .hero-stats {
    display: flex;
    gap: clamp(24px, 3.5vw, 48px);
    margin-top: 40px;
    padding-top: 26px;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .hv-dark .hero-stats { border-top-color: rgba(128, 188, 226, 0.25); }
  .hs-val { font-size: 24px; font-weight: 700; color: var(--blue-deep); letter-spacing: -0.02em; }
  .hv-dark .hs-val { color: var(--blue); }
  .hs-label { font-size: 12.5px; color: var(--soft); margin-top: 2px; max-width: 160px; }
  .hv-dark .hs-label { color: #8aabb8; }

  .hero-form-panel { max-width: 520px; width: 100%; justify-self: end; }
  .hv-form { background: linear-gradient(135deg, var(--navy) 0%, #1d3a4d 100%); }
  .hv-form .hero-title { color: #fff; }
  .hv-form .hero-sub { color: #8aabb8; }
  .hv-form .hero-stats { border-top-color: rgba(128, 188, 226, 0.25); }
  .hv-form .hs-val { color: var(--blue); }
  .hv-form .hs-label { color: #8aabb8; }
  .hv-form .hero-kicker { color: var(--blue); }

  .hv-panel {
    border-radius: 20px;
    display: flex; align-items: center; justify-content: center;
    padding: clamp(28px, 4vw, 48px);
    min-height: 340px;
  }
  .dark-panel { background: var(--navy-2); }
  .light-panel { background: var(--blue-light); border: 1px solid var(--border); }

  .hv-collage { position: relative; height: 480px; }
  .hvc-glow {
    position: absolute;
    inset: 10% 5%;
    background: radial-gradient(closest-side, rgba(128, 188, 226, 0.28), transparent);
    border-radius: 50%;
  }
  .hvc-device { position: absolute; top: 6%; left: 8%; }
  .hvc-phone { position: absolute; top: 26%; right: 4%; z-index: 2; }
  .hvc-terminal { position: absolute; bottom: 4%; left: 18%; }

  .hv-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 300px 195px;
    gap: 12px;
  }
  .pv-tile {
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--white);
  }
  .pv-main { background: radial-gradient(420px 300px at 50% 40%, rgba(128, 188, 226, 0.2), transparent), var(--blue-faint); }
  .pv-app { background: #14222e; border-color: #24384a; }
  .pv-patch { background: var(--blue-faint); gap: 14px; }
  .pv-terminal { background: var(--blue-faint); }
  .pv-label {
    position: absolute;
    bottom: 12px; left: 15px;
    font-size: 10.5px; font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
    color: var(--soft);
  }
  .pv-label.on-dark { color: #56788c; }
  .patch-item { display: flex; flex-direction: column; align-items: center; gap: 9px; font-size: 11.5px; color: var(--mid); font-weight: 600; text-align: center; max-width: 110px; line-height: 1.35; }
  .patch-circle {
    width: 64px; height: 64px; border-radius: 50%;
    border: 2px dashed var(--blue);
    color: var(--blue-deep);
    display: flex; align-items: center; justify-content: center;
    background: #fff;
  }
  .patch-circle.alt { border-color: #b9c6cf; color: var(--mid); }

  .ward-visual {
    background: #14222e;
    border: 1px solid #24384a;
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 30px 80px rgba(20, 34, 46, 0.35);
  }
  .ward-head { display: flex; justify-content: space-between; margin-bottom: 16px; font-size: 11px; font-weight: 700; letter-spacing: 0.09em; color: #7a9baa; }
  .ward-ok { color: #6fd39a; }
  .ward-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
  .ward-cell {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 12px 13px;
    display: flex; flex-direction: column; gap: 3px;
  }
  .ward-cell.alert { background: rgba(255, 107, 107, 0.13); border-color: rgba(255, 107, 107, 0.45); }
  .ward-cell.warn { background: rgba(224, 136, 0, 0.1); border-color: rgba(224, 136, 0, 0.35); }
  .wc-bed { font-size: 10px; font-weight: 700; letter-spacing: 0.07em; color: #56788c; }
  .wc-temp { font-size: 19px; font-weight: 700; color: #d7e6ef; }
  .ward-cell.alert .wc-temp { color: #ff8a8a; }
  .ward-cell.warn .wc-temp { color: #e8a54a; }
  .ward-alertbar {
    margin-top: 14px;
    background: rgba(255, 107, 107, 0.12);
    border: 1px solid rgba(255, 107, 107, 0.32);
    border-radius: 9px;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 600;
    color: #ff8a8a;
  }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hv-collage { height: 380px; }
    .hero-form-panel { justify-self: stretch; max-width: none; }
  }
</style>