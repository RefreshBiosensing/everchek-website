---
// CSS-drawn bedside terminal mock. Replace with a real product photo when available.
interface Props { width?: number }
const { width = 150 } = Astro.props;
---
<div class="terminal-box" style={`--w:${width}px`}>
  <div class="term-screen">
    <div class="term-val">38.0</div>
    <div class="term-sub">°C · BODY TEMP</div>
    <div class="term-line"></div>
    <div class="term-peak">38.8</div>
    <div class="term-peak-label">PEAK</div>
  </div>
  <div class="term-btn"></div>
</div>

<style>
  .terminal-box {
    width: var(--w);
    background: linear-gradient(160deg, #fdfdfd, #eef2f5);
    border-radius: calc(var(--w) * 0.09);
    padding: calc(var(--w) * 0.09) calc(var(--w) * 0.1);
    border: 1px solid #dfe6ea;
    box-shadow: 0 18px 44px rgba(22, 36, 46, 0.14);
    text-align: center;
  }
  .term-screen {
    background: linear-gradient(170deg, #eaf5d4, #d4e8a0);
    border-radius: calc(var(--w) * 0.045);
    padding: calc(var(--w) * 0.07) calc(var(--w) * 0.08);
    box-shadow: inset 0 2px 8px rgba(42, 90, 26, 0.14);
  }
  .term-val { font-size: calc(var(--w) * 0.19); font-weight: 700; color: #2a5a1a; font-family: 'SF Mono', ui-monospace, monospace; line-height: 1.1; }
  .term-sub { font-size: calc(var(--w) * 0.05); color: #4a7a2a; letter-spacing: 0.07em; font-weight: 600; }
  .term-line { height: 1px; background: #b8d880; margin: calc(var(--w) * 0.04) 0; }
  .term-peak { font-size: calc(var(--w) * 0.12); font-weight: 700; color: #2a5a1a; font-family: 'SF Mono', ui-monospace, monospace; }
  .term-peak-label { font-size: calc(var(--w) * 0.045); color: #6a8a52; font-weight: 600; letter-spacing: 0.06em; }
  .term-btn {
    width: calc(var(--w) * 0.14);
    height: calc(var(--w) * 0.14);
    border-radius: 50%;
    border: 1px solid #c8d2d8;
    background: linear-gradient(180deg, #f4f7f9, #e2e8ec);
    margin: calc(var(--w) * 0.06) auto 0;
  }
</style>
