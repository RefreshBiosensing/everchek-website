---
// 图文区块 — one component, three layouts:
//   layout: "top"   → 上图下文
//   layout: "left"  → 左图右文
//   layout: "right" → 右图左文
import BlockImage from './BlockImage.astro';
import Icon from '../Icon.astro';

interface Props {
  layout?: 'top' | 'left' | 'right';
  eyebrow?: string;
  title?: string;
  text?: string;
  paragraphs?: string[];
  bullets?: string[];
  bulletsTitle?: string;   // small label above the tick list (e.g. "Key credentials")
  steps?: string[];   // numbered vertical sequence next to the image (how-it-works blocks)
  note?: string;      // small callout under the copy
  image?: string;
  imageAlt?: string;
  imageNote?: string;
  ratio?: string;
  fit?: 'cover' | 'contain';
  mediaSize?: 'default' | 'compact';
  imageBrandPatch?: string;
  cta?: { label: string; href: string };
  tint?: boolean;
  /** layout 'top': render the heading above the image, as a section header */
  headingFirst?: boolean;
  /** Ground colour behind a figure whose own background is baked into the file.
      Sample the image's edge pixel and pass it here so the two blend seamlessly. */
  figureBg?: string;
  /** Section heading rendered above the whole block (its own H2), separate from
      `title`, which stays with the copy beside the image. */
  sectionTitle?: string;
  sectionText?: string;
  /** Role / subtitle line directly under `title`. */
  role?: string;
}
const {
  layout = 'left',
  eyebrow, title, text, paragraphs = [], bullets = [], bulletsTitle, steps = [], note,
  image, imageAlt, imageNote, ratio = '4/3', fit = 'cover',
  mediaSize = 'default', imageBrandPatch,
  cta, tint = false, headingFirst = false, figureBg, sectionTitle, sectionText, role,
} = Astro.props;
const bodyParagraphs = paragraphs.length > 0 ? paragraphs : (text ? [text] : []);
---
<section class:list={['section', 'it-section', { tint }]} style={figureBg ? `background:${figureBg}` : undefined}>
  {sectionTitle && (
    <div class="container it-header">
      <h2 class="it-title">{sectionTitle}</h2>
      {sectionText && <p class="it-header-text">{sectionText}</p>}
    </div>
  )}
  {headingFirst && !sectionTitle && (title || bodyParagraphs.length > 0) && (
    <div class="container it-header">
      {eyebrow && <div class="it-eyebrow">{eyebrow}</div>}
      {title && <h2 class="it-title">{title}</h2>}
      {bodyParagraphs.map((paragraph) => <p class="it-header-text">{paragraph}</p>)}
    </div>
  )}
  <div class:list={['container', 'it-grid', `is-${layout}`, { 'has-header': headingFirst || Boolean(sectionTitle) }]}>
    <div class:list={['it-media', { compact: mediaSize === 'compact', blend: Boolean(figureBg) }]} style={figureBg ? `background:${figureBg}` : undefined}>
      <BlockImage src={image} alt={imageAlt ?? title ?? ''} ratio={ratio} note={imageNote} fit={fit} />
      {imageBrandPatch && <span class="it-image-brand" aria-hidden="true">{imageBrandPatch}</span>}
    </div>
    <div class="it-body">
      {(!headingFirst || sectionTitle) && eyebrow && <div class="it-eyebrow">{eyebrow}</div>}
      {(!headingFirst || sectionTitle) && title && <h2 class="it-title">{title}</h2>}
      {role && <p class="it-role">{role}</p>}
      {(!headingFirst || sectionTitle) && bodyParagraphs.length > 0 && (
        <div class="it-copy">
          {bodyParagraphs.map((paragraph) => <p class="it-text">{paragraph}</p>)}
        </div>
      )}
      {steps.length > 0 && (
        <ol class="it-steps">
          {steps.map((st) => (
            <li class="it-step"><span class="it-step-num" aria-hidden="true"></span><span class="it-step-text">{st}</span></li>
          ))}
        </ol>
      )}
      {bullets.length > 0 && bulletsTitle && <div class="it-bullets-title">{bulletsTitle}</div>}
      {bullets.length > 0 && (
        <ul class="checks it-bullets">
          {bullets.map((b) => <li>{b}</li>)}
        </ul>
      )}
      {note && <p class="it-note">{note}</p>}
      {cta && (
        <a class="btn primary it-cta" href={cta.href}>{cta.label} <Icon name="arrow" size={15} /></a>
      )}
    </div>
  </div>
</section>

<style>
  .it-grid { display: grid; gap: clamp(28px, 4vw, 60px); align-items: center; }
  /* Section-header layout: heading and intro centred above a full-width figure,
     matching the original .section-header + .anatomy-single-image pattern. */
  .it-header { text-align: center; max-width: 720px; margin: 0 auto clamp(28px, 4vw, 44px); }
  .it-header .it-title { margin-bottom: 12px; }
  .it-header-text { font-size: 16.5px; line-height: 1.7; color: var(--mid); }

  /* A diagram with its own baked ground never matches a flat section colour
     exactly — this file's edges range from #F1F3F7 to #F9FAFD. Rather than
     chase the colour, feather the figure's edges so there is no boundary to
     see, and drop the corner radius that would otherwise cut a visible arc. */
  .it-media.blend :global(img) {
    border-radius: 0;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0, #000 34px, #000 calc(100% - 34px), transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 26px, #000 calc(100% - 26px), transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0, #000 34px, #000 calc(100% - 34px), transparent 100%),
      linear-gradient(to bottom, transparent 0, #000 26px, #000 calc(100% - 26px), transparent 100%);
    mask-composite: intersect;
  }
  .it-role { font-size: 15.5px; font-weight: 600; color: var(--ec-blue-600); margin: -4px 0 16px; }
  .it-grid.has-header.is-top { grid-template-columns: 1fr !important; }
  .it-grid.has-header .it-body:empty { display: none; }
  .it-grid.has-header .it-media { max-width: 980px; margin: 0 auto; }
  .it-media { position: relative; width: 100%; }
  .it-media.compact { max-width: 390px; justify-self: center; }
  .it-image-brand {
    position: absolute;
    right: 0;
    bottom: 0;
    min-width: 128px;
    padding: 12px 18px;
    border-radius: 8px 0 var(--radius) 0;
    background: #d9edf9;
    color: var(--blue-deep);
    font-size: 15px;
    font-weight: 800;
    line-height: 1;
    text-align: center;
  }
  .is-left { grid-template-columns: 1fr 1fr; }
  .is-right { grid-template-columns: 1fr 1fr; }
  .is-right .it-media { order: 2; }
  .is-top { grid-template-columns: 1fr; max-width: 900px; }
  .is-top .it-body { text-align: center; }
  .is-top .it-text { margin-left: auto; margin-right: auto; }
  .is-top .it-bullets { display: inline-flex; text-align: left; }

  .it-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0;
    text-transform: none; color: var(--blue-deep); margin-bottom: 12px;
  }
  .it-title {
    font-size: clamp(22px, 2.5vw, 30px); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.25; margin-bottom: 14px;
  }
  .it-text { font-size: 15.5px; color: var(--mid); line-height: 1.75; max-width: 620px; }
  .it-copy { display: grid; gap: 12px; }
  .it-bullets { margin-top: 18px; }
  .it-bullets-title {
    margin-top: 22px;
    font-size: 12.5px; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase; color: var(--blue-deep);
  }
  .it-bullets-title + .it-bullets { margin-top: 10px; }

  .it-steps { counter-reset: it-step; list-style: none; margin: 20px 0 0; padding: 0; }
  .it-step {
    counter-increment: it-step;
    position: relative;
    display: flex; align-items: flex-start; gap: 16px;
    padding-bottom: 22px;
  }
  .it-step:last-child { padding-bottom: 0; }
  .it-step:not(:last-child)::before {
    content: '';
    position: absolute; left: 15px; top: 34px; bottom: 2px;
    width: 2px; background: var(--blue-light);
  }
  .it-step-num {
    flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%;
    background: var(--blue-light); border: 1px solid var(--border);
    color: var(--blue-deep); font-size: 14px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    position: relative; z-index: 1;
  }
  .it-step-num::after { content: counter(it-step); }
  .it-step-text { font-size: 15px; line-height: 1.65; color: var(--ink); padding-top: 4px; }

  .it-note {
    margin-top: 24px; padding: 13px 16px;
    background: var(--blue-faint); border-left: 3px solid var(--blue);
    border-radius: 0 8px 8px 0;
    font-size: 13.5px; line-height: 1.65; color: var(--mid);
  }
  .it-cta { margin-top: 24px; }

  @media (max-width: 820px) {
    .is-left, .is-right { grid-template-columns: 1fr; }
    .is-right .it-media { order: 0; }
  }
</style>
