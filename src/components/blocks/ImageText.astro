---
// 图文区块 — one component, three layouts:
//   layout: "top"   → 上图下文
//   layout: "left"  → 左图右文
//   layout: "right" → 右图左文
import BlockImage from './BlockImage.astro';
import Icon from '../Icon.astro';

interface Props {
  layout?: 'top' | 'left' | 'right';
  eyebrow?: string;
  title?: string;
  text?: string;
  paragraphs?: string[];
  bullets?: string[];
  image?: string;
  imageAlt?: string;
  imageNote?: string;
  ratio?: string;
  fit?: 'cover' | 'contain';
  mediaSize?: 'default' | 'compact';
  imageBrandPatch?: string;
  cta?: { label: string; href: string };
  tint?: boolean;
}
const {
  layout = 'left',
  eyebrow, title, text, paragraphs = [], bullets = [],
  image, imageAlt, imageNote, ratio = '4/3', fit = 'cover',
  mediaSize = 'default', imageBrandPatch,
  cta, tint = false,
} = Astro.props;
const bodyParagraphs = paragraphs.length > 0 ? paragraphs : (text ? [text] : []);
---
<section class:list={['section', 'it-section', { tint }]}>
  <div class:list={['container', 'it-grid', `is-${layout}`]}>
    <div class:list={['it-media', { compact: mediaSize === 'compact' }]}>
      <BlockImage src={image} alt={imageAlt ?? title ?? ''} ratio={ratio} note={imageNote} fit={fit} />
      {imageBrandPatch && <span class="it-image-brand" aria-hidden="true">{imageBrandPatch}</span>}
    </div>
    <div class="it-body">
      {eyebrow && <div class="it-eyebrow">{eyebrow}</div>}
      {title && <h2 class="it-title">{title}</h2>}
      {bodyParagraphs.length > 0 && (
        <div class="it-copy">
          {bodyParagraphs.map((paragraph) => <p class="it-text">{paragraph}</p>)}
        </div>
      )}
      {bullets.length > 0 && (
        <ul class="checks it-bullets">
          {bullets.map((b) => <li>{b}</li>)}
        </ul>
      )}
      {cta && (
        <a class="btn primary it-cta" href={cta.href}>{cta.label} <Icon name="arrow" size={15} /></a>
      )}
    </div>
  </div>
</section>

<style>
  .it-grid { display: grid; gap: clamp(28px, 4vw, 60px); align-items: center; }
  .it-media { position: relative; width: 100%; }
  .it-media.compact { max-width: 390px; justify-self: center; }
  .it-image-brand {
    position: absolute;
    right: 0;
    bottom: 0;
    min-width: 128px;
    padding: 12px 18px;
    border-radius: 8px 0 var(--radius) 0;
    background: #d9edf9;
    color: var(--blue-deep);
    font-size: 15px;
    font-weight: 800;
    line-height: 1;
    text-align: center;
  }
  .is-left { grid-template-columns: 1fr 1fr; }
  .is-right { grid-template-columns: 1fr 1fr; }
  .is-right .it-media { order: 2; }
  .is-top { grid-template-columns: 1fr; max-width: 900px; }
  .is-top .it-body { text-align: center; }
  .is-top .it-text { margin-left: auto; margin-right: auto; }
  .is-top .it-bullets { display: inline-flex; text-align: left; }

  .it-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0;
    text-transform: none; color: var(--blue-deep); margin-bottom: 12px;
  }
  .it-title {
    font-size: clamp(22px, 2.5vw, 30px); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1.25; margin-bottom: 14px;
  }
  .it-text { font-size: 15.5px; color: var(--mid); line-height: 1.75; max-width: 620px; }
  .it-copy { display: grid; gap: 12px; }
  .it-bullets { margin-top: 18px; }
  .it-cta { margin-top: 24px; }

  @media (max-width: 820px) {
    .is-left, .is-right { grid-template-columns: 1fr; }
    .is-right .it-media { order: 0; }
  }
</style>
