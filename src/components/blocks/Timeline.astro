---
// 时间线 — vertical event列表. tone controls the dot colour: blue | red | green.
interface Item { time: string; event: string; detail?: string; tag?: string; tone?: 'blue' | 'red' | 'green' }
interface Props {
  title?: string;
  sub?: string;
  items: Item[];
  dark?: boolean;
  tint?: boolean;
}
const { title, sub, items = [], dark = true, tint = false } = Astro.props;
---
<section class:list={['section', 'tlb', { dark, tint }]}>
  <div class="container tlb-inner">
    {title && <h2 class="tlb-title">{title}</h2>}
    {sub && <p class="tlb-sub">{sub}</p>}
    <div class="tlb-list">
      <div class="tlb-line"></div>
      {items.map((it) => (
        <div class="tlb-item">
          <div class:list={['tlb-dot', it.tone ?? 'blue']}></div>
          <div class="tlb-time">{it.time}</div>
          <div class="tlb-event">{it.event}</div>
          {it.detail && <div class="tlb-detail">{it.detail}</div>}
          {it.tag && <div class:list={['tlb-tag', it.tone ?? 'blue']}>{it.tag}</div>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tlb.dark { background: var(--navy-2); }
  .tlb-inner { max-width: 980px; }
  .tlb-title {
    font-size: clamp(24px, 2.8vw, 34px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.18;
    max-width: 900px;
  }
  .dark .tlb-title { color: #fff; }
  .tlb-sub {
    font-size: 16px;
    color: var(--mid);
    margin-top: 12px;
    line-height: 1.75;
    max-width: 900px;
  }
  .dark .tlb-sub { color: #8aabb8; }

  .tlb-list { position: relative; padding-left: 32px; margin-top: 42px; max-width: 900px; }
  .tlb-line {
    position: absolute; left: 7px; top: 8px; bottom: 8px; width: 2px;
    background: linear-gradient(to bottom, var(--blue), #2a4a5e);
  }
  .dark .tlb-line { background: linear-gradient(to bottom, var(--blue), #2a4a5e); }

  .tlb-item { position: relative; margin-bottom: 38px; padding-left: 28px; }
  .tlb-item:last-child { margin-bottom: 0; }
  .tlb-dot {
    position: absolute; left: -32px; top: 4px;
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--blue);
    border: 3px solid var(--navy-2);
    box-shadow: 0 0 0 2px var(--blue);
  }
  .tlb:not(.dark) .tlb-dot { border-color: #fff; }
  .tlb-dot.red { background: #ff6b6b; box-shadow: 0 0 0 2px #ff6b6b; }
  .tlb-dot.green { background: #51c78a; box-shadow: 0 0 0 2px #51c78a; }

  .tlb-time { font-size: 11.5px; font-weight: 700; color: var(--blue); letter-spacing: 0.05em; margin-bottom: 5px; }
  .tlb-event { font-size: 17px; font-weight: 700; margin-bottom: 8px; line-height: 1.35; }
  .dark .tlb-event { color: #fff; }
  .tlb-detail { font-size: 14.5px; line-height: 1.75; color: var(--mid); max-width: 820px; }
  .dark .tlb-detail { color: #8aabb8; }
  .tlb-tag {
    display: inline-block; margin-top: 11px;
    background: rgba(128, 188, 226, 0.14);
    border: 1px solid rgba(128, 188, 226, 0.32);
    border-radius: 12px; padding: 3px 11px;
    font-size: 11.5px; color: var(--blue-deep);
  }
  .dark .tlb-tag { color: var(--blue); }
  .tlb-tag.red { background: rgba(255, 107, 107, 0.12); border-color: rgba(255, 107, 107, 0.32); color: #d94a4a; }
  .dark .tlb-tag.red { color: #ff8a8a; }
  .tlb-tag.green { background: rgba(81, 199, 138, 0.12); border-color: rgba(81, 199, 138, 0.32); color: #2a9d5c; }
  .dark .tlb-tag.green { color: #51c78a; }
</style>
