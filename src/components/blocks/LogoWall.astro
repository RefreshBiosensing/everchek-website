---
// 客户 / 认证 Logo 墙 — grid of logos, or labelled placeholders until they exist.
import BlockImage from './BlockImage.astro';

interface Item { image?: string; name: string }
interface Props {
  title?: string;
  text?: string;
  items: Item[];
  columns?: 3 | 4 | 5 | 6;
  tint?: boolean;
}
const { title, text, items = [], columns = 5, tint = true } = Astro.props;
---
<section class:list={['section', { tint }]}>
  <div class="container">
    {title && <h2 class="lw-title">{title}</h2>}
    {text && <p class="lw-text">{text}</p>}
    <div class:list={['lw-grid', `cols-${columns}`]}>
      {items.map((it) => (
        <div class="lw-item" title={it.name}>
          {it.image
            ? <img class="lw-logo" src={it.image} alt={it.name} loading="lazy" decoding="async" />
            : <div class="lw-ph">{it.name}</div>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .lw-title { font-size: clamp(20px, 2.2vw, 26px); font-weight: 700; letter-spacing: -0.02em; text-align: center; }
  .lw-text { font-size: 15px; color: var(--mid); text-align: center; margin-top: 10px; }
  .lw-grid { display: grid; gap: 14px; margin-top: 32px; }
  .cols-3 { grid-template-columns: repeat(3, 1fr); }
  .cols-4 { grid-template-columns: repeat(4, 1fr); }
  .cols-5 { grid-template-columns: repeat(5, 1fr); }
  .cols-6 { grid-template-columns: repeat(6, 1fr); }

  .lw-item {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    height: 84px;
    display: flex; align-items: center; justify-content: center;
    padding: 14px;
  }
  .lw-logo { max-height: 100%; max-width: 100%; object-fit: contain; filter: grayscale(1); opacity: 0.72; transition: all 0.2s ease; }
  .lw-item:hover .lw-logo { filter: none; opacity: 1; }
  .lw-ph {
    font-size: 12px; font-weight: 600; color: var(--soft);
    text-align: center; line-height: 1.35;
    border: 1px dashed var(--blue);
    border-radius: 6px;
    padding: 8px 10px;
    width: 100%;
  }

  @media (max-width: 900px) { .cols-5, .cols-6 { grid-template-columns: repeat(3, 1fr); } .cols-4 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 500px) { .lw-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
