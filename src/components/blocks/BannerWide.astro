---
// 横版通栏 — full-bleed image with text overlaid. Falls back to the navy
// brand gradient when no image is set, so it looks intentional either way.
import Icon from '../Icon.astro';

interface Props {
  image?: string;
  imageAlt?: string;
  imageNote?: string;
  eyebrow?: string;
  title?: string;
  text?: string;
  cta?: { label: string; href: string };
  cta2?: { label: string; href: string };
  align?: 'left' | 'center';
  height?: 'short' | 'tall';
}
const {
  image, imageAlt, imageNote,
  eyebrow, title, text, cta, cta2,
  align = 'left', height = 'short',
} = Astro.props;
---
<section
  class:list={['bw', `bw-${height}`, `bw-${align}`, { 'bw-photo': !!image }]}
  style={image ? `background-image:linear-gradient(rgba(11,26,36,.62),rgba(11,26,36,.62)),url('${image}')` : undefined}
  role={image ? 'img' : undefined}
  aria-label={image ? (imageAlt ?? title) : undefined}
>
  <div class="container bw-inner">
    {eyebrow && <div class="bw-eyebrow">{eyebrow}</div>}
    {title && <h2 class="bw-title">{title}</h2>}
    {text && <p class="bw-text">{text}</p>}
    {(cta || cta2) && (
      <div class="bw-ctas">
        {cta && <a class="btn primary" href={cta.href}>{cta.label} <Icon name="arrow" size={15} /></a>}
        {cta2 && <a class="btn on-dark" href={cta2.href}>{cta2.label}</a>}
      </div>
    )}
    {!image && import.meta.env.DEV && (
      <div class="bw-ph">缺图占位（仅开发环境可见）：横版通栏背景{imageNote ? ` — ${imageNote}` : ''} · 建议 2400×900px · 16/6</div>
    )}
  </div>
</section>

<style>
  .bw {
    background: linear-gradient(135deg, var(--navy) 0%, #1d3a4d 100%);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
  }
  .bw-short { min-height: clamp(280px, 30vw, 380px); padding: clamp(40px, 5vw, 64px) 0; }
  .bw-tall { min-height: clamp(400px, 46vw, 560px); padding: clamp(56px, 6vw, 88px) 0; }

  .bw-photo { border-block: 1px solid rgba(128, 188, 226, 0.2); }

  .bw-inner { max-width: 100%; }
  .bw-center .bw-inner { text-align: center; }
  .bw-center .bw-text { margin-left: auto; margin-right: auto; }

  .bw-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0;
    text-transform: none; color: var(--blue); margin-bottom: 12px;
  }
  .bw-title {
    font-size: clamp(24px, 3.2vw, 38px); font-weight: 700;
    color: #fff; letter-spacing: -0.02em; line-height: 1.2; max-width: 780px;
  }
  .bw-center .bw-title { margin-left: auto; margin-right: auto; }
  .bw-text { font-size: 16px; color: #b8cdd9; line-height: 1.7; margin-top: 14px; max-width: 640px; }
  .bw-ctas { margin-top: 26px; display: flex; gap: 12px; flex-wrap: wrap; }
  .bw-center .bw-ctas { justify-content: center; }

  .bw-ph {
    margin-top: 22px;
    display: inline-block;
    font-size: 11.5px;
    color: #7fa8bd;
    border: 1px dashed rgba(128, 188, 226, 0.45);
    border-radius: 999px;
    padding: 6px 14px;
  }
</style>
