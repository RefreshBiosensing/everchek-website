---
// CSS-drawn companion-app mock. Replace with a real app screenshot when available.
interface Props { width?: number }
const { width = 150 } = Astro.props;
---
<div class="app-phone" style={`--w:${width}px`}>
  <div class="app-bar"><span>EverChek App</span><span class="live">● LIVE</span></div>
  <div class="app-temp-big">38.6°</div>
  <div class="app-temp-label">BODY TEMP · CELSIUS</div>
  <svg class="app-curve" viewBox="0 0 90 40" preserveAspectRatio="none">
    <defs>
      <linearGradient id="curveFill" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0B5FA5" stop-opacity="0.22"/>
        <stop offset="1" stop-color="#0B5FA5" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <path d="M0,35 10,33 20,28 30,22 40,18 50,14 60,10 70,12 80,16 90,20 L90,40 0,40 Z" fill="url(#curveFill)"/>
    <polyline points="0,35 10,33 20,28 30,22 40,18 50,14 60,10 70,12 80,16 90,20" fill="none" stroke="#0B5FA5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <line x1="0" y1="15" x2="90" y2="15" stroke="#ff6b6b" stroke-width="0.8" stroke-dasharray="3 2" opacity="0.65"/>
  </svg>
  <div class="app-row">
    <div><div class="app-stat-val">38.6</div><div class="app-stat-key">CURRENT</div></div>
    <div><div class="app-stat-val">39.1</div><div class="app-stat-key">PEAK</div></div>
    <div><div class="app-stat-val">6h</div><div class="app-stat-key">DURATION</div></div>
  </div>
  <div class="app-alert">⚠ Alert threshold crossed</div>
</div>

<style>
  .app-phone {
    width: var(--w);
    background: #0d1b26;
    border-radius: calc(var(--w) * 0.14);
    border: 2px solid #2a3f52;
    padding: calc(var(--w) * 0.1) calc(var(--w) * 0.08) calc(var(--w) * 0.08);
    box-shadow: 0 26px 60px rgba(13, 27, 38, 0.45);
  }
  .app-bar { display: flex; justify-content: space-between; margin-bottom: calc(var(--w) * 0.07); }
  .app-bar span { font-size: calc(var(--w) * 0.055); color: #7a9baa; font-weight: 700; letter-spacing: 0.04em; }
  .app-bar .live { color: #6fd39a; }
  .app-temp-big { font-size: calc(var(--w) * 0.21); font-weight: 700; color: var(--blue); text-align: center; line-height: 1; }
  .app-temp-label { font-size: calc(var(--w) * 0.05); color: #4a7a92; text-align: center; margin: calc(var(--w) * 0.02) 0 calc(var(--w) * 0.06); letter-spacing: 0.09em; font-weight: 600; }
  .app-curve { width: 100%; height: calc(var(--w) * 0.3); margin-bottom: calc(var(--w) * 0.06); }
  .app-row { display: flex; justify-content: space-between; padding: 0 calc(var(--w) * 0.02); }
  .app-stat-val { font-size: calc(var(--w) * 0.07); font-weight: 700; color: #fff; text-align: center; }
  .app-stat-key { font-size: calc(var(--w) * 0.042); color: #4a7a92; margin-top: 1px; text-align: center; letter-spacing: 0.07em; font-weight: 600; }
  .app-alert {
    background: rgba(255, 107, 107, 0.14);
    border: 1px solid rgba(255, 107, 107, 0.3);
    border-radius: 6px;
    padding: calc(var(--w) * 0.035) calc(var(--w) * 0.05);
    margin-top: calc(var(--w) * 0.06);
    font-size: calc(var(--w) * 0.05);
    color: #ff8a8a;
    text-align: center;
    font-weight: 600;
  }
</style>
