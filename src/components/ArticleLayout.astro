---
// Long-form article layout — reproduces the original blog template:
// a sticky "On this page" sidebar beside a constrained reading column.
//
// The rebuilt articles are section lists like every other page, so the sections
// still render through SectionRenderer; this wrapper puts them in the reading
// column, narrows the containers, and restores the article typography. The
// contents list is built from each section's own heading, so it stays in sync
// with the content without a second source of truth.
interface Props {
  headings: { id: string; label: string }[];
  tocLabel?: string;
}
const { headings = [], tocLabel = 'On this page' } = Astro.props;
---
<div class="article-layout">
  {headings.length > 1 && (
    <aside class="article-sidebar">
      <h4 class="toc-head">{tocLabel}</h4>
      <ul class="article-toc">
        {headings.map((h) => (
          <li><a href={`#${h.id}`}>{h.label}</a></li>
        ))}
      </ul>
    </aside>
  )}
  <div class="article-body">
    <slot />
  </div>
</div>

<script>
  // Highlight the section currently in view, as the original template did.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.article-toc a')];
  if (links.length) {
    const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
    const seen = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) seen.add(e.target.id);
          else seen.delete(e.target.id);
        }
        links.forEach((a) => a.classList.remove('active'));
        const first = [...byId.keys()].find((id) => seen.has(id));
        if (first) byId.get(first)?.classList.add('active');
      },
      { rootMargin: '-90px 0px -70% 0px' },
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  .article-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    gap: 48px;
  }
  .article-sidebar { position: sticky; top: 92px; align-self: start; padding-top: 48px; }
  .toc-head {
    font-size: 12px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 1px; color: var(--mid); margin-bottom: 16px;
  }
  .article-toc { list-style: none; padding: 0; margin: 0; }
  .article-toc li { margin-bottom: 4px; }
  .article-toc a {
    display: block; font-size: 13px; line-height: 1.45; color: var(--mid);
    padding: 6px 12px; border-radius: 6px; text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .article-toc a:hover { color: var(--ink); background: var(--ec-blue-50); }
  .article-toc a.active {
    color: var(--ec-blue-600); border-left-color: var(--ec-blue-600);
    background: var(--ec-blue-50); font-weight: 600;
  }

  .article-body { max-width: 720px; padding: 48px 0 80px; min-width: 0; }

  /* The sections inside are ordinary page sections. In an article they must read
     as one continuous document: no banded backgrounds, no section padding, no
     centred marketing headings, and one reading measure throughout. */
  .article-body :global(section) { padding: 0 !important; background: transparent !important; }
  .article-body :global(.container) { max-width: 100% !important; padding: 0 !important; }
  .article-body :global(h2) {
    font-size: 24px; font-weight: 600; margin: 48px 0 16px;
    color: var(--ink); scroll-margin-top: 90px; text-align: left; letter-spacing: -0.01em;
  }
  .article-body :global(h3) { font-size: 19px; font-weight: 600; margin: 32px 0 12px; color: var(--ink); text-align: left; }
  .article-body :global(h4) { font-size: 17px; font-weight: 600; margin: 24px 0 8px; color: var(--ink); }
  .article-body :global(p) { font-size: 16px; line-height: 1.8; color: var(--mid); margin-bottom: 16px; }
  .article-body :global(ul) { padding-left: 20px; margin-bottom: 16px; }
  .article-body :global(li) { font-size: 16px; line-height: 1.8; color: var(--mid); margin-bottom: 8px; }
  .article-body :global(strong) { color: var(--ink); }
  .article-body :global(a) { color: var(--ec-blue-600); text-decoration: underline; text-underline-offset: 2px; }
  .article-body :global(figure) { margin: 32px 0 40px; }
  .article-body :global(img) { border-radius: 12px; box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08); }
  /* An article figure is a full-width <figure> in the reading column, never an
     image beside text — that shape belongs on a marketing page, not in prose. */
  .article-body :global(.it-grid) {
    display: block !important;
    max-width: 100% !important;
  }
  .article-body :global(.it-media) { margin: 32px 0 12px; }
  .article-body :global(.it-media img) {
    width: 100%; border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }
  /* Caption sits under the figure, at caption size. */
  .article-body :global(.it-body) { margin-bottom: 28px; }
  .article-body :global(.it-body .it-title) { font-size: 19px; margin: 8px 0 10px; }
  /* Marketing components degrade to prose inside an article. The originals used
     a plain <ul> with a bolded lead-in; cards, step tiles and tick panels are a
     landing-page device and read as clutter in the middle of a 2,400-word piece. */
  .article-body :global(.cg-grid),
  .article-body :global(.sf-grid),
  .article-body :global(.cl-list) {
    display: block !important;
    margin: 0 0 16px !important;
  }
  .article-body :global(.cg-card),
  .article-body :global(.sf-card),
  .article-body :global(.sf-rail-card) {
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 0 14px !important;
    display: list-item;
    list-style: disc;
    margin-left: 20px !important;
    transform: none !important;
  }
  /* The icon plate, the big step number and the tick chip are all decoration. */
  /* A card kicker is a small label above the title. Flattened into a bullet it
     becomes an orphan line — usually just a number — so it runs inline instead. */
  .article-body :global(.cg-kicker) {
    display: inline !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    color: var(--ink) !important;
    margin: 0 !important;
  }
  .article-body :global(.cg-kicker)::after { content: '. '; }
  .article-body :global(.cg-icon),
  .article-body :global(.cg-media),
  .article-body :global(.sf-icon),
  .article-body :global(.sf-num),
  .article-body :global(.sf-rail-num),
  .article-body :global(.sf-arrow) { display: none !important; }
  /* The card heading becomes the bolded lead-in of its bullet. */
  .article-body :global(.cg-card-title),
  .article-body :global(.sf-card-title),
  .article-body :global(.sf-rail-title) {
    display: inline !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    color: var(--ink) !important;
    margin: 0 !important;
  }
  .article-body :global(.cg-card-title)::after,
  .article-body :global(.sf-card-title)::after,
  .article-body :global(.sf-rail-title)::after { content: ': '; }
  .article-body :global(.cg-card-text),
  .article-body :global(.sf-card-desc),
  .article-body :global(.sf-rail-desc) {
    display: inline !important;
    font-size: 16px !important;
    line-height: 1.8 !important;
    color: var(--mid) !important;
    margin: 0 !important;
  }
  .article-body :global(.sf-rail-panel),
  .article-body :global(.sf-rail-step) {
    background: transparent !important; border: 0 !important;
    padding: 0 !important; max-width: 100% !important; display: block !important;
  }
  .article-body :global(.sf-rail-step)::before { display: none !important; }
  .article-body :global(.cl-wrap),
  .article-body :global(.cl-list .panel) { max-width: 100% !important; background: transparent !important; border: 0 !important; padding: 0 !important; }

  /* The FAQ and the related-links strip are shared marketing sections. Inside an
     article they are part of the document: the original had a plain left-aligned
     <h2>Frequently asked questions</h2> and no eyebrow above it. */
  .article-body :global(.faq-wrap .eyebrow) { display: none !important; }
  .article-body :global(.faq-section h2) {
    text-align: left !important;
    font-size: 24px !important;
    font-weight: 600 !important;
    margin: 48px 0 16px !important;
    scroll-margin-top: 90px;
  }
  .article-body :global(.rel-row) { text-align: left !important; justify-content: flex-start !important; }

  /* Section components centre their intro copy because that suits a marketing
     page. In an article every paragraph is body text and must be left-aligned. */
  .article-body :global(.it-text),
  .article-body :global(.cg-text),
  .article-body :global(.cg-note),
  .article-body :global(.lede),
  .article-body :global(.sf-text),
  .article-body :global(.deep-sub),
  .article-body :global(.bx-text) {
    text-align: left !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    max-width: 100% !important;
  }
  .article-body :global(.cg-head),
  .article-body :global(.sf-head),
  .article-body :global(.deep-head) { text-align: left !important; }
  .article-body :global(.cg-title),
  .article-body :global(.sf-title),
  .article-body :global(.deep-title) { text-align: left !important; margin-left: 0 !important; }

  @media (max-width: 980px) {
    .article-layout { grid-template-columns: 1fr; gap: 0; }
    .article-sidebar { display: none; }
    .article-body { padding-top: 32px; max-width: none; }
  }
</style>
