---
// Long-form SEO content section rendered as alternating visual rows.
import Icon from './Icon.astro';

interface Block { heading?: string; text: string }
interface Props {
  eyebrow?: string;
  title?: string;
  sub?: string;
  blocks: Block[];
  tint?: boolean;
}
const { eyebrow = 'In depth', title, sub, blocks, tint = false } = Astro.props;
const visualIcons = ['curve', 'bell', 'sensor', 'hospital', 'data', 'cloud'];
---
<section class:list={['section', 'deep-section', { tint }]}>
  <div class="container deep-wrap">
    {title && (
      <div class="deep-head">
        <div class="eyebrow">{eyebrow}</div>
        <h2 class="h2 center">{title}</h2>
        {sub && <p class="deep-sub">{sub}</p>}
      </div>
    )}
    <div class="deep-body">
      {blocks.map((b, i) => (
        <article class:list={['deep-row', { rev: i % 2 === 1 }]}>
          <div class="deep-visual" aria-hidden="true">
            <div class="deep-orbit">
              <Icon name={visualIcons[i % visualIcons.length]} size={58} />
            </div>
            <div class="deep-lines">
              <span></span><span></span><span></span>
            </div>
          </div>
          <div class="deep-copy">
            {b.heading && <h3 class="deep-h3">{b.heading}</h3>}
            <p class="deep-text">{b.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .deep-head { text-align: center; margin-bottom: clamp(34px, 5vw, 58px); }
  .deep-head .h2 { margin-left: auto; margin-right: auto; max-width: none; white-space: nowrap; font-size: clamp(22px, 3vw, 42px); }
  .deep-sub { max-width: 680px; margin: 14px auto 0; color: var(--mid); font-size: 15.5px; line-height: 1.7; }
  .deep-body { display: flex; flex-direction: column; gap: clamp(34px, 5vw, 64px); }
  .deep-row {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .deep-row.rev { grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr); }
  .deep-row.rev .deep-visual { order: 2; }

  .deep-visual {
    min-height: 260px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(260px 180px at 50% 42%, rgba(128, 188, 226, 0.22), transparent 72%),
      #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .deep-orbit {
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: var(--blue-light);
    border: 1px solid rgba(128, 188, 226, 0.55);
    color: var(--blue-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 22px 54px rgba(90, 157, 196, 0.18);
    z-index: 2;
  }
  .deep-lines {
    position: absolute;
    inset: auto 28px 28px;
    display: grid;
    gap: 8px;
  }
  .deep-lines span {
    display: block;
    height: 9px;
    border-radius: 99px;
    background: rgba(128, 188, 226, 0.18);
  }
  .deep-lines span:nth-child(2) { width: 74%; }
  .deep-lines span:nth-child(3) { width: 54%; }

  .deep-h3 { font-size: clamp(19px, 2vw, 24px); font-weight: 700; letter-spacing: -0.01em; margin-bottom: 11px; color: var(--ink); line-height: 1.3; }
  .deep-text { font-size: 15.5px; color: var(--mid); line-height: 1.85; max-width: 660px; }

  @media (max-width: 820px) {
    .deep-head .h2 { white-space: normal; }
    .deep-row, .deep-row.rev { grid-template-columns: 1fr; }
    .deep-row.rev .deep-visual { order: 0; }
    .deep-visual { min-height: 210px; }
  }
</style>
