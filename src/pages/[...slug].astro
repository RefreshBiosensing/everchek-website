---
// The only route. Every page on the site is a YAML section list in
// content/pages/<locale>/, rendered here through SectionRenderer.
// Localised slugs come from each page's own `path` field, so /es/... URLs
// need no extra routing. hreflang comes from translationKey siblings.
import Base from '../layouts/Base.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import { loadAllPages, alternatesFor, type PageEntry } from '../lib/content';

export function getStaticPaths() {
  return loadAllPages().map((page) => {
    // "/products/x/" → "products/x"; the home page ("/") → undefined
    const slug = page.path.replace(/^\/|\/$/g, '');
    return {
      params: { slug: slug === '' ? undefined : slug },
      props: { page },
    };
  });
}

interface Props { page: PageEntry }
const { page } = Astro.props;
const alternates = alternatesFor(page);
const hero = page.sections.find((section) => section?.type === 'hero');
const heroTitle = hero?.title ?? page.title;
const heroImagePath = hero?.image ?? hero?.backgroundImage;
const heroImage = heroImagePath ? new URL(heroImagePath, Astro.site).toString() : undefined;
const pageUrl = new URL(page.path, Astro.site).toString();

const schema =
  page.schemaType === 'product'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: page.title,
        description: page.description,
        brand: { '@type': 'Brand', name: 'EverChek' },
        manufacturer: { '@id': new URL('/#organization', Astro.site).toString() },
        category: 'Medical Device / Continuous Glucose Monitoring System',
      }
    : page.schemaType === 'article'
      ? {
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: heroTitle,
          description: page.description,
          ...(heroImage ? { image: heroImage } : {}),
          mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
          articleSection: 'CGM Manufacturing',
          author: { '@id': new URL('/#organization', Astro.site).toString() },
          publisher: {
            '@type': 'Organization',
            name: 'EverChek',
          },
        }
    : undefined;
---
<Base
  title={page.title}
  description={page.description}
  image={heroImage}
  locale={page.locale}
  alternates={alternates}
  noindex={page.noindex}
  schema={schema}
>
  <SectionRenderer sections={page.sections} locale={page.locale} />
</Base>
