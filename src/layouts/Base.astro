---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Alternate } from '../lib/content';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object;
  noindex?: boolean;
  /** Page locale — sets <html lang> and which UI dictionary Header/Footer use */
  locale?: string;
  /** Sibling pages in other locales (same translationKey) — emitted as hreflang */
  alternates?: Alternate[];
}
const {
  title,
  description,
  image,
  schema,
  noindex = false,
  locale = 'en',
  alternates = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// hreflang: only meaningful when the page exists in 2+ locales.
// x-default points at the English version by convention.
const hreflangs =
  alternates.length > 1
    ? [
        ...alternates.map((a) => ({ lang: a.locale, href: new URL(a.path, Astro.site).toString() })),
        {
          lang: 'x-default',
          href: new URL(
            (alternates.find((a) => a.locale === 'en') ?? alternates[0]).path,
            Astro.site,
          ).toString(),
        },
      ]
    : [];

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'P20',
  url: Astro.site?.toString(),
  email: 'contact@ever-chek.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Room 902, Building 1, Hengtaiyu Building, Tangwei Community, Fenghuang Street',
    addressLocality: 'Guangming District, Shenzhen',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'contact@ever-chek.com',
    telephone: '+86-191-6859-8056',
  },
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
