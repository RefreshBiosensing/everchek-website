---
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Alternate } from '../lib/content';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object;
  noindex?: boolean;
  /** Page locale — sets <html lang> and which UI dictionary Header/Footer use */
  locale?: string;
  /** Sibling pages in other locales (same translationKey) — emitted as hreflang */
  alternates?: Alternate[];
}
const {
  title,
  description,
  image,
  schema,
  noindex = false,
  locale = 'en',
  alternates = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// hreflang: only meaningful when the page exists in 2+ locales.
// x-default points at the English version by convention.
const hreflangs =
  alternates.length > 1
    ? [
        ...alternates.map((a) => ({ lang: a.locale, href: new URL(a.path, Astro.site).toString() })),
        {
          lang: 'x-default',
          href: new URL(
            (alternates.find((a) => a.locale === 'en') ?? alternates[0]).path,
            Astro.site,
          ).toString(),
        },
      ]
    : [];

// One canonical Organization entity for the whole site, given a stable @id so
// every page's schema can reference it instead of redeclaring the company.
//
// `sameAs` is what lets an answer engine confirm which "EverChek" this is. It
// matters here more than usual: searching the brand today returns Senseonics'
// Eversense and unrelated Shenzhen firms, not this company. Add each profile URL
// below as it goes live — LinkedIn company page, Made-in-China and Alibaba
// verified-supplier profiles, Crunchbase, YouTube. An entry that 404s is worse
// than no entry, so only list profiles that actually resolve.
const SAME_AS = [
  'https://www.refresh.cc/',
];

// BreadcrumbList from the URL path. The site had none anywhere; it gives search
// and answer engines the page's place in the hierarchy without any per-page work.
// Home-only pages get nothing — a one-item breadcrumb is noise.
const crumbSegments = (Astro.url.pathname || '/').split('/').filter(Boolean);
const breadcrumbSchema =
  crumbSegments.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: new URL('/', Astro.site).toString(),
          },
          ...crumbSegments.map((seg, i) => ({
            '@type': 'ListItem',
            position: i + 2,
            // last segment gets the real page title; intermediates get a
            // de-slugified label, since /blog/ has no page of its own
            name:
              i === crumbSegments.length - 1
                ? title
                : seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
            item: new URL(
              `/${crumbSegments.slice(0, i + 1).join('/')}/`,
              Astro.site,
            ).toString(),
          })),
        ],
      }
    : undefined;

// Analytics. Set PUBLIC_GA_ID in Cloudflare Pages > Settings > Environment
// variables (e.g. G-XXXXXXXXXX) and the tag ships; leave it unset and nothing
// loads at all, so local builds and previews stay clean.
// The site previously had no analytics of any kind, which meant a silent form
// failure would have been invisible and the whole exercise unmeasurable.
const GA_ID = import.meta.env.PUBLIC_GA_ID;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).toString(),
  name: 'EverChek',
  alternateName: 'Refresh EverChek',
  description:
    'B2B-only manufacturer of continuous glucose monitoring (CGM) systems, supplying OEM, ODM, SKD kit and private-label programmes to medical-device distributors, healthcare brands and government tender bidders.',
  foundingDate: '2016',
  parentOrganization: {
    '@type': 'Organization',
    name: 'Refresh.cc',
    url: 'https://www.refresh.cc/',
  },
  sameAs: SAME_AS,
  url: Astro.site?.toString(),
  email: 'contact@ever-chek.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Room 902, Building 1, Hengtaiyu Building, Tangwei Community, Fenghuang Street',
    addressLocality: 'Guangming District, Shenzhen',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'contact@ever-chek.com',
    telephone: '+86-191-6859-8056',
  },
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {hreflangs.map((h) => (
      <link rel="alternate" hreflang={h.lang} href={h.href} />
    ))}
    {GA_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', GA_ID);
          // First page of the visit, so an enquiry sent later from /contact/
          // still records where the visitor actually arrived.
          try {
            if (!sessionStorage.getItem('ec_landing')) {
              sessionStorage.setItem('ec_landing', location.pathname + location.search);
            }
          } catch (e) {}
        </script>
      </>
    )}
    <link rel="icon" href="/images/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/images/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
